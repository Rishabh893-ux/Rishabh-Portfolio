# Copy to .env.local for local dev, or add these in Vercel → Project → Settings → Environment Variables.

# Formspree form ID (the part after /f/ in your form's endpoint). Defaults to the site's own form,
# so leave this commented out unless you want a different form. An empty value makes the form use mailto.
# NEXT_PUBLIC_FORMSPREE_ID=

# Your public URL once a custom domain is connected, e.g. https://rishabhkasaudhan.dev
# On Vercel this can stay empty — the production URL is detected automatically.
NEXT_PUBLIC_SITE_URL=

# "Ask my AI" chat: a Gemini API key from https://aistudio.google.com/apikey (server-only, never sent to the browser).
# Without it the chat explains that the assistant isn't switched on and shows the contact email.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash).
# GEMINI_MODEL=
